{
  "name": "contest-notifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Detects upcoming coding contests (Codeforces, AtCoder, CodeChef) and syncs them to Google Calendar and Google Tasks.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "contest-notifier": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/cli.ts",
    "fetch": "tsx src/cli.ts fetch",
    "dry-run": "tsx src/cli.ts dry-run",
    "status": "tsx src/cli.ts status",
    "auth": "tsx src/cli.ts auth",
    "run": "tsx src/cli.ts run",
    "start": "node --disable-warning=ExperimentalWarning dist/cli.js"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "google-auth-library": "^11.1.0",
    "googleapis": "^182.0.0",
    "luxon": "^3.7.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
